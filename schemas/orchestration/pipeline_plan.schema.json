{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-analytics.local/schemas/orchestration/pipeline_plan.schema.json",
  "title": "Single-player pipeline plan (Stage 14A)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "plan_id",
    "request_id",
    "run_id",
    "config_fingerprint",
    "stages",
    "created_at_utc",
    "plan_fingerprint"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "plan_id": { "type": "string", "minLength": 4 },
    "request_id": { "type": "string", "minLength": 4 },
    "run_id": { "type": "string", "minLength": 8 },
    "config_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "created_at_utc": { "type": "string", "minLength": 10 },
    "plan_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "stages": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "order", "cache_key", "depends_on"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 0 },
          "cache_key": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
          "depends_on": {
            "type": "array",
            "items": { "type": "string" }
          },
          "mode": {
            "type": "string",
            "enum": ["fixture_entrypoint", "synthetic_stub", "report_builder"]
          }
        }
      }
    },
    "warnings": {
      "type": "array",
      "items": { "type": "string" }
    }
  }
}
