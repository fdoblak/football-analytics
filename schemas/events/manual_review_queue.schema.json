{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-analytics.local/schemas/events/manual_review_queue.schema.json",
  "title": "Target events manual review queue (Stage 13)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "queue_id",
    "run_id",
    "video_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "queue_id": {
      "type": "string"
    },
    "run_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "entries": {
      "type": "array"
    }
  }
}
