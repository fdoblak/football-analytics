{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-analytics.local/schemas/events/events_request.schema.json",
  "title": "Target events request (Stage 13)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "video_id",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 8
    },
    "video_id": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "type": "object",
      "required": [
        "no_real_events_inference"
      ],
      "properties": {
        "no_real_events_inference": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
