{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-analytics.local/schemas/events/events_quality.schema.json",
  "title": "Target events quality (Stage 13)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "coverage": {
      "type": "object",
      "required": [
        "never_invent_live_when_replay_uncertain",
        "append_only_ledger"
      ],
      "properties": {
        "never_invent_live_when_replay_uncertain": {
          "type": "boolean",
          "const": true
        },
        "append_only_ledger": {
          "type": "boolean",
          "const": true
        }
      }
    }
  }
}
