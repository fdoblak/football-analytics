{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://football-analytics.local/schemas/events/events_run_receipt.schema.json",
  "title": "Target events run receipt (Stage 13)",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "run_id",
    "video_id",
    "accuracy_claims"
  ],
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "run_id": {
      "type": "string"
    },
    "video_id": {
      "type": "string"
    },
    "accuracy_claims": {
      "type": "object",
      "required": [
        "opta_accuracy_validated",
        "real_football_accuracy_validated"
      ],
      "properties": {
        "opta_accuracy_validated": {
          "type": "boolean",
          "const": false
        },
        "real_football_accuracy_validated": {
          "type": "boolean",
          "const": false
        }
      }
    }
  }
}
